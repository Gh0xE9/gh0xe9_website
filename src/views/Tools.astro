---
import Base from '../layouts/Base.astro';
import { links, toolRepoHrefs } from '../lib/site';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const repoHrefs = toolRepoHrefs;
---

<Base locale={locale} title={copy.tools.title} description={copy.tools.description} route="/TOOLS">
  <header class="page-hero">
    <p class="kicker">{copy.tools.kicker}</p>
    <h1>{copy.tools.title}</h1>
    {copy.tools.intro ? <p>{copy.tools.intro}</p> : null}
  </header>

  <section class="section">
    <div class="wrap">
      <ul class="index-list">
        {
          copy.tools.items.map((item, i) => {
            const href = repoHrefs[item.id];
            const kind =
              item.kind === 'github'
                ? copy.tools.githubKind
                : item.kind === 'internal'
                  ? copy.tools.internalKind
                  : copy.tools.officialKind;
            return (
              <li>
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  {href ? (
                    <a class="name" href={href} rel="noopener">
                      {item.name}
                      <span class="en">{kind}</span>
                    </a>
                  ) : (
                    <h2 class="name" style="margin: 0;">
                      {item.name}
                      <span class="en">{kind}</span>
                    </h2>
                  )}
                </div>
                <p>{item.body}</p>
              </li>
            );
          })
        }
      </ul>
      <div class="actions">
        <a class="btn" href={links.github} rel="noopener">
          {copy.tools.openGithub} <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>
