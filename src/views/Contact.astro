---
import Base from '../layouts/Base.astro';
import { links } from '../lib/site';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={copy.contact.title} description={copy.contact.description} route="/CONTACT">
  <header class="page-hero">
    <p class="kicker">{copy.contact.kicker}</p>
    <h1>{copy.contact.title}</h1>
    <p>{copy.contact.intro}</p>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <a class="contact-card" href={links.official} rel="noopener">
          <span class="kind">Official</span>
          <h3>{copy.contact.officialTitle}</h3>
          <p>gh0xe9.top</p>
        </a>
        <a class="contact-card" href={links.github} rel="noopener">
          <span class="kind">Code</span>
          <h3>GitHub</h3>
          <p>github.com/Gh0xE9</p>
        </a>
        <a class="contact-card" href={links.x} rel="noopener">
          <span class="kind">Updates</span>
          <h3>X / Twitter</h3>
          <p>@Gh0xE9</p>
        </a>
        <div class="contact-card" aria-label={copy.contact.wechatAria}>
          <span class="kind">WeChat</span>
          <h3>{copy.contact.wechatTitle}</h3>
          <p>{links.wechat.name} · ID {links.wechat.id}</p>
        </div>
      </div>
      <p class="note" style="margin-top: 2rem;">{copy.contact.welcome}</p>
    </div>
  </section>
</Base>
