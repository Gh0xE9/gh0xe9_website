---
import Base from '../layouts/Base.astro';
import { localizeHref, type Locale } from '../lib/i18n';
import { t } from '../lib/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={copy.notFound.title} description={copy.notFound.description} route="/404">
  <section class="miss">
    <p class="kicker">{copy.notFound.kicker}</p>
    <h1 class="display" style="font-size: clamp(4.5rem, 18vw, 10rem);">0x404</h1>
    <p class="lede">{copy.notFound.lede}</p>
    <div class="actions">
      <a class="btn btn--solid" href={localizeHref(locale, '/')}>
        {copy.notFound.home} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn" href={localizeHref(locale, '/articles/')}>{copy.notFound.articles}</a>
    </div>
  </section>
</Base>
