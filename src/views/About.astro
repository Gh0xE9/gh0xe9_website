---
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/messages';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={copy.about.title} description={copy.about.description} route="/ABOUT">
  <header class="page-hero">
    <p class="kicker">{copy.about.kicker}</p>
    <h1>{copy.about.title}</h1>
    <p>{copy.about.intro}</p>
  </header>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">{copy.about.identityKicker}</p>
        <Wordmark class="wm--about" />
        <h2 class="section__title" style="font-size: clamp(2rem, 5vw, 3.4rem);">{copy.about.identityTitle}</h2>
      </div>
      <div>
        <p class="lede">{copy.about.identityLede}</p>
        <p>{copy.about.identityBody}</p>
        <p class="note">{copy.about.identityNote}</p>
      </div>
    </div>
  </section>
</Base>
