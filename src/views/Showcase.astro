---
import Base from '../layouts/Base.astro';
import VisionFigure from '../components/VisionFigure.astro';
import { localizeHref, type Locale } from '../lib/i18n';
import { t } from '../lib/messages';
import { getShowcase } from '../lib/visions';
import '../styles/visions.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const show = getShowcase(locale);
---

<Base locale={locale} title={show.title} description={show.lede} route="/SERVICES/SHOW">
  <article class="show" data-show>
    <header class="show__intro">
      <p class="show__kicker">{show.kicker}</p>
      <h1>{show.title}</h1>
      <p class="show__lede">{show.lede}</p>
      <p class="show__hint"><span>↓</span> {show.hint}</p>
    </header>

    {
      show.acts.map((act) => (
        <section class="show__act" data-act={act.no}>
          <div class="show__act-copy">
            <p class="show__no">{act.no}</p>
            <h2>{act.title}</h2>
            <p class="show__purpose">{act.purpose}</p>
            <div class="actions">
              <a class="btn btn--solid" href={localizeHref(locale, `/services/${act.no}/`)}>
                {copy.services.visionCta} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <div class="show__figure">
            <VisionFigure name={act.figure} />
          </div>
        </section>
      ))
    }

    <footer class="show__outro">
      <p class="show__kicker">{show.outroKicker}</p>
      <h2>{show.outroTitle}</h2>
      <p>{show.outroBody}</p>
      <div class="actions">
        <a class="btn" href={localizeHref(locale, '/services/')}>
          {copy.services.visionBack} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href={localizeHref(locale, '/contact/')}>
          {copy.services.contactUs} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </footer>
  </article>
</Base>

<script>
  function bindShow() {
    const root = document.querySelector('[data-show]');
    if (!root) return;
    const scenes = root.querySelectorAll('.show__intro, .show__act, .show__outro');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      scenes.forEach((node) => node.classList.add('is-on'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-on', entry.isIntersecting);
        }
      },
      { threshold: 0.35 },
    );
    scenes.forEach((node) => io.observe(node));
  }

  bindShow();
  document.addEventListener('astro:page-load', bindShow);
</script>
