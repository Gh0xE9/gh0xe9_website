---
import Base from '../layouts/Base.astro';
import { localizeHref, type Locale } from '../lib/i18n';
import { t } from '../lib/messages';
import { getServiceDeck, getDeckUi } from '../lib/showcase-content';
import { getFieldMode, serviceNos, type ServiceNo } from '../lib/service-scenes';
import '../styles/showcase.css';

interface Props {
  locale: Locale;
  no: ServiceNo;
}

const { locale, no } = Astro.props;
const copy = t(locale);
const service = copy.services.items.find((item) => item.no === no);
if (!service) throw new Error(`Unknown service ${no}`);

const deck = getServiceDeck(locale, no);
const ui = getDeckUi(locale);
const mode = getFieldMode(no);
const idx = serviceNos.indexOf(no);
const nextNo = serviceNos[(idx + 1) % serviceNos.length];
const nextService = copy.services.items.find((item) => item.no === nextNo);
---

<Base
  locale={locale}
  title={service.title}
  description={service.body}
  route={`/SERVICES/${no}`}
  serviceHero
>
  <div class="dk" data-deck data-mode={mode} data-scene="boot">
    <canvas class="dk-bg" data-bg aria-hidden="true"></canvas>
    <div class="dk-scan" aria-hidden="true"></div>
    <div class="dk-grain" aria-hidden="true"></div>
    <div class="dk-frame" aria-hidden="true"></div>
    <div class="dk-progress" aria-hidden="true"><i data-progress></i></div>

    <div class="dk-stage" data-stage>
      {
        deck.scenes.map((scene, i) => (
          <section class="dk-scene" data-kind={scene.kind} data-name={scene.name}>
            <div class="dk-scene__inner">
              <p class="dk-kicker">
                {scene.kind === 'stage'
                  ? `STAGE ${String(scene.stageNo).padStart(2, '0')} / ${String(scene.stageCount).padStart(2, '0')} — ${scene.kicker}`
                  : scene.kicker}
              </p>
              {i === 0 ? (
                <h1 class="dk-title">{scene.title}</h1>
              ) : (
                <h2 class="dk-title">{scene.title}</h2>
              )}

              {scene.kind === 'boot' && (
                <p class="dk-addr" aria-hidden="true">
                  0xE9::SERVICES/{no}
                </p>
              )}

              {scene.body && <p class="dk-body">{scene.body}</p>}

              {scene.lines && (
                <ul class="dk-lines">
                  {scene.lines.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )}

              {scene.kind === 'outro' && (
                <nav class="dk-outro" aria-label={copy.services.title}>
                  <a class="dk-outro__row" href={localizeHref(locale, '/services/')}>
                    <span class="dk-outro__idx">↩</span>
                    <span class="dk-outro__name">{ui.backToServices}</span>
                  </a>
                  {nextService && (
                    <a class="dk-outro__row" href={localizeHref(locale, `/services/${nextNo}/`)}>
                      <span class="dk-outro__idx">{nextNo}</span>
                      <span class="dk-outro__name">
                        {ui.nextService} — {nextService.title}
                      </span>
                    </a>
                  )}
                  <a class="dk-outro__row" href={localizeHref(locale, '/contact/')}>
                    <span class="dk-outro__idx">@</span>
                    <span class="dk-outro__name">{ui.contact}</span>
                  </a>
                </nav>
              )}
            </div>
            {scene.kind === 'boot' && (
              <p class="dk-no" aria-hidden="true">
                {no}
              </p>
            )}
            {scene.kind === 'stage' && (
              <p class="dk-stage-no" aria-hidden="true">
                {String(scene.stageNo).padStart(2, '0')}
                <span>/{String(scene.stageCount).padStart(2, '0')}</span>
              </p>
            )}
          </section>
        ))
      }
    </div>

    <div class="dk-chrome">
      <p class="dk-counter" aria-hidden="true">
        <b data-counter-cur>01</b>
        <span>{ui.sceneOf}{String(deck.scenes.length).padStart(2, '0')}</span>
        <em data-counter-name>{deck.scenes[0].name}</em>
      </p>
      <div class="dk-actions">
        <button
          type="button"
          class="dk-play"
          data-play
          data-play-label={ui.play}
          data-pause-label={ui.pause}
          aria-pressed="false"
        >
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5v9l7-4.5z" /></svg>
          <span>{ui.play}</span>
        </button>
        <a class="dk-exit" href={localizeHref(locale, '/services/')}>✕</a>
      </div>
    </div>

    <nav class="dk-rail" data-rail aria-label={service.title}>
      {
        deck.scenes.map((scene, i) => (
          <button
            type="button"
            data-goto={i}
            aria-label={`${String(i + 1).padStart(2, '0')} ${scene.name}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span class="dk-rail__name">
              {String(i + 1).padStart(2, '0')} {scene.name}
            </span>
            <span class="dk-rail__dot" aria-hidden="true" />
          </button>
        ))
      }
    </nav>

    <div class="dk-jmp" data-jmp aria-hidden="true">
      <span class="dk-jmp__bar"></span>
      <span class="dk-jmp__text" data-jmp-text></span>
    </div>

    <p class="dk-hint" data-hint aria-hidden="true">
      <span class="dk-hint__key">↓</span>
      {ui.scrollHint}
    </p>
  </div>
</Base>

<script>
  import { initShowcase } from '../lib/showcase-engine';

  initShowcase();
  document.addEventListener('astro:page-load', initShowcase);
</script>
