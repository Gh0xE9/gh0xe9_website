---
import Base from '../layouts/Base.astro';
import { formatDate, links, services, site, tools } from '../lib/site';
import { getPublishedArticles } from '../lib/articles';

const latest = (await getPublishedArticles()).slice(0, 4);
---

<Base route="/HOME">
  <section class="hero">
    <div class="hero__meta">
      <span><b>0xE9</b> · x86 near jmp</span>
      <span>{site.mottoEn}</span>
    </div>
    <h1 class="hero__name">Gh<span class="ox">0x</span><span class="e9">E9</span></h1>
    <p class="hero__tag">{site.tagline}</p>
    <div class="hero__grid">
      <div>
        <p class="lede">
          <strong>{site.mottoZh}</strong>
          我们做授权的红队评估、蓝队响应与取证、代码审计，也承办和训练 CTF。名字写在字节里：<strong>0xE9</strong> 是一次跳转，线索往往就在跳转之前。
        </p>
        <div class="actions">
          <a class="btn btn--solid" href="/articles/">阅读文章 <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn" href="/about/">了解团队 <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <pre class="disasm" aria-hidden="true">
<span class="cmt">; Ghost In The Bytes</span>
00401000  <span class="op">E9</span> <span class="imm">1A 00 00 00</span>    jmp  +0x1A
00401005  47 68 6F 73 74    <span class="cmt">; "Ghost"</span>
0040100A  20 49 6E 20       <span class="cmt">; " In "</span>
      </pre>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <div>
          <p class="kicker">01 / Services</p>
          <h2 class="section__title">业务<span>.</span></h2>
        </div>
        <p class="section__note">公开介绍的四项工作，不做夸大。</p>
      </div>
      <ul class="index-list">
        {
          services.map((item) => (
            <li>
              <span class="no">{item.no}</span>
              <div>
                <h3>{item.title}<span class="en">{item.titleEn}</span></h3>
              </div>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="btn" href="/services/">查看业务说明 <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <div>
          <p class="kicker">02 / Tools</p>
          <h2 class="section__title">工具<span>.</span></h2>
        </div>
        <p class="section__note">来自官网介绍与 GitHub 公开仓库。</p>
      </div>
      <ul class="index-list">
        {
          tools.slice(0, 4).map((item, i) => (
            <li>
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                {item.href ? (
                  <a class="name" href={item.href} rel="noopener">
                    {item.name}
                    <span class="en">{item.kind}</span>
                  </a>
                ) : (
                  <h3>
                    {item.name}
                    <span class="en">{item.kind}</span>
                  </h3>
                )}
              </div>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="btn" href="/tools/">全部工具与项目 <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={links.github} rel="noopener">GitHub 组织 <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <div>
          <p class="kicker">03 / Articles</p>
          <h2 class="section__title">文章<span>.</span></h2>
        </div>
        <p class="section__note">团队后续会在这里发布技术文章。</p>
      </div>
      {
        latest.length > 0 ? (
          <ul class="article-list">
            {latest.map((post) => (
              <li>
                <a href={`/articles/${post.id}/`}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <h3>{post.data.title}</h3>
                  <span class="tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">还没有已发布的文章。</p>
        )
      }
      <div class="actions">
        <a class="btn" href="/articles/">进入文章栏目 <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
