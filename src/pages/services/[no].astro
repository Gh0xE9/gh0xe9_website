---
import ServiceHero from '../../views/ServiceHero.astro';
import { serviceNos, type ServiceNo } from '../../lib/service-scenes';

export function getStaticPaths() {
  return serviceNos.map((no) => ({ params: { no } }));
}

const { no } = Astro.params;
---

<ServiceHero locale="zh" no={no as ServiceNo} />
