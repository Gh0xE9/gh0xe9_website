---
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/site';
import { getPublishedArticles } from '../../lib/articles';

const posts = await getPublishedArticles();
---

<Base
  title="文章"
  description="Gh0xE9 团队的技术文章。后续新稿会以 Markdown 的形式发布在这个栏目。"
  route="/ARTICLES"
>
  <header class="page-hero">
    <p class="kicker">Field notes</p>
    <h1>文章</h1>
    <p>
      团队会在这里发布自己的技术文章。新稿带有日期与标签，按时间排列。我们不转载公众号或其他平台的原文。
    </p>
  </header>

  <section class="section">
    <div class="wrap">
      {
        posts.length > 0 ? (
          <ul class="article-list">
            {posts.map((post) => (
              <li>
                <a href={`/articles/${post.id}/`}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <div>
                    <h2>{post.data.title}</h2>
                    <p class="note" style="margin: 0.35rem 0 0;">{post.data.description}</p>
                  </div>
                  <span class="tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">还没有已发布的文章。</p>
        )
      }
    </div>
  </section>
</Base>
