---
import Base from '../layouts/Base.astro';
import { links } from '../lib/site';
---

<Base
  title="联系"
  description="通过已有官网、GitHub、X、CTFtime 或微信公众号联系 Gh0xE9。"
  route="/CONTACT"
>
  <header class="page-hero">
    <p class="kicker">Get in touch</p>
    <h1>联系</h1>
    <p>
      目前公开可核验的联系方式如下。本站不公布邮箱名册。高校与社区同伴若有意加入，可先通过这些窗口打招呼。
    </p>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <a class="contact-card" href={links.official} rel="noopener">
          <span class="kind">Official</span>
          <h3>已有官网</h3>
          <p>team.iloli.moe</p>
        </a>
        <a class="contact-card" href={links.github} rel="noopener">
          <span class="kind">Code</span>
          <h3>GitHub</h3>
          <p>github.com/Gh0xE9</p>
        </a>
        <a class="contact-card" href={links.x} rel="noopener">
          <span class="kind">Updates</span>
          <h3>X / Twitter</h3>
          <p>@Gh0xE9</p>
        </a>
        <a class="contact-card" href={links.ctftime} rel="noopener">
          <span class="kind">CTF</span>
          <h3>CTFtime</h3>
          <p>Team 170814</p>
        </a>
        <div class="contact-card" aria-label="微信公众号">
          <span class="kind">WeChat</span>
          <h3>公众号</h3>
          <p>{links.wechat.name} · ID {links.wechat.id}</p>
        </div>
      </div>
      <p class="note" style="margin-top: 2rem;">
        欢迎高校与社区成员加入。公开资料里的原话是：Just join us，Gh0xE9 Team Welcomes universities and community members to join.
      </p>
    </div>
  </section>
</Base>
