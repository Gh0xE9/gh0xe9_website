---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<div class:list={['vfig', `vfig--${name}`, className]} aria-hidden="true">
  {
    name === 'loop' && (
      <svg viewBox="0 0 400 400" fill="none">
        <circle class="vfig__orbit" cx="200" cy="200" r="128" />
        <circle class="vfig__orbit vfig__orbit--2" cx="200" cy="200" r="86" />
        <g class="vfig__nodes">
          <circle cx="200" cy="72" r="8" />
          <circle cx="328" cy="200" r="8" />
          <circle cx="200" cy="328" r="8" />
          <circle cx="72" cy="200" r="8" />
        </g>
        <path class="vfig__runner" d="M200 72 A128 128 0 1 1 199.9 72" />
        <text class="vfig__label" x="200" y="58" text-anchor="middle">ASSET</text>
        <text class="vfig__label" x="348" y="204" text-anchor="start">TRAFFIC</text>
        <text class="vfig__label" x="200" y="354" text-anchor="middle">LOG</text>
        <text class="vfig__label" x="52" y="204" text-anchor="end">ALERT</text>
        <text class="vfig__core" x="200" y="208" text-anchor="middle">LOOP</text>
      </svg>
    )
  }
  {
    name === 'timeline' && (
      <svg viewBox="0 0 400 400" fill="none">
        <line class="vfig__axis" x1="40" y1="220" x2="360" y2="220" />
        <g class="vfig__ticks">
          <line x1="70" y1="210" x2="70" y2="230" />
          <line x1="130" y1="210" x2="130" y2="230" />
          <line x1="190" y1="210" x2="190" y2="230" />
          <line x1="250" y1="210" x2="250" y2="230" />
          <line x1="310" y1="210" x2="310" y2="230" />
        </g>
        <g class="vfig__frags">
          <rect x="58" y="86" width="72" height="10" />
          <rect x="150" y="64" width="48" height="10" />
          <rect x="220" y="92" width="90" height="10" />
          <rect x="80" y="300" width="60" height="10" />
          <rect x="200" y="318" width="110" height="10" />
        </g>
        <polyline class="vfig__trace" points="70,180 130,140 190,200 250,120 310,168" />
      </svg>
    )
  }
  {
    name === 'corridor' && (
      <svg viewBox="0 0 400 400" fill="none">
        <path class="vfig__wall" d="M70 360 L170 80 H230 L330 360" />
        <path class="vfig__fence" d="M90 360 L180 110 H220 L310 360" />
        <path class="vfig__path" d="M200 350 C 190 280, 220 200, 200 120" />
        <line class="vfig__gate" x1="170" y1="80" x2="230" y2="80" />
        <text class="vfig__label" x="200" y="68" text-anchor="middle">SCOPE</text>
      </svg>
    )
  }
  {
    name === 'signals' && (
      <svg viewBox="0 0 400 400" fill="none">
        <g class="vfig__stars">
          <circle cx="80" cy="90" r="2.5" />
          <circle cx="140" cy="70" r="1.8" />
          <circle cx="210" cy="110" r="2.2" />
          <circle cx="300" cy="80" r="1.6" />
          <circle cx="330" cy="150" r="2" />
          <circle cx="90" cy="200" r="1.7" />
          <circle cx="160" cy="180" r="2.4" />
          <circle cx="250" cy="200" r="2" />
          <circle cx="310" cy="240" r="1.8" />
          <circle cx="120" cy="280" r="2.1" />
          <circle cx="200" cy="300" r="2.6" />
          <circle cx="280" cy="310" r="1.7" />
        </g>
        <path class="vfig__constellation" d="M80 90 L160 180 L210 110 L250 200 L200 300 L120 280 L160 180 L250 200 L310 240 L330 150" />
        <circle class="vfig__pulse" cx="200" cy="300" r="6" />
      </svg>
    )
  }
  {
    name === 'protocol' && (
      <svg viewBox="0 0 400 400" fill="none">
        <path class="vfig__wave" d="M40 130 C 80 70, 120 190, 160 130 S 240 70, 280 130 S 360 190, 360 130" />
        <path class="vfig__wave vfig__wave--2" d="M40 200 C 80 150, 120 250, 160 200 S 240 150, 280 200 S 360 250, 360 200" />
        <path class="vfig__wave vfig__wave--3" d="M40 270 C 80 230, 120 310, 160 270 S 240 230, 280 270 S 360 310, 360 270" />
        <rect class="vfig__pkt" x="70" y="318" width="60" height="22" />
        <rect class="vfig__pkt" x="150" y="318" width="80" height="22" />
        <rect class="vfig__pkt" x="250" y="318" width="50" height="22" />
        <text class="vfig__label" x="200" y="50" text-anchor="middle">SOFTWARE LAYER ONLY</text>
      </svg>
    )
  }
  {
    name === 'ground' && (
      <svg viewBox="0 0 400 400" fill="none">
        <g class="vfig__boards">
          <rect x="50" y="70" width="140" height="90" />
          <rect x="210" y="70" width="140" height="90" />
          <rect x="50" y="180" width="140" height="90" />
          <rect x="210" y="180" width="140" height="90" />
        </g>
        <text class="vfig__flag" x="120" y="126" text-anchor="middle">01</text>
        <text class="vfig__flag" x="280" y="126" text-anchor="middle">02</text>
        <text class="vfig__flag" x="120" y="236" text-anchor="middle">03</text>
        <text class="vfig__flag" x="280" y="236" text-anchor="middle">04</text>
        <line class="vfig__axis" x1="50" y1="320" x2="350" y2="320" />
        <text class="vfig__label" x="200" y="350" text-anchor="middle">TRAINING GROUND</text>
      </svg>
    )
  }
  {
    name === 'burst' && (
      <svg viewBox="0 0 400 400" fill="none">
        <g class="vfig__shards">
          <path d="M200 200 L 80 70 L 140 90 Z" />
          <path d="M200 200 L 330 60 L 300 120 Z" />
          <path d="M200 200 L 360 210 L 330 260 Z" />
          <path d="M200 200 L 90 300 L 140 330 Z" />
          <path d="M200 200 L 70 180 L 90 140 Z" />
        </g>
        <text class="vfig__core vfig__core--xl" x="200" y="214" text-anchor="middle">0xE9</text>
      </svg>
    )
  }
  {
    name === 'clock' && (
      <svg viewBox="0 0 400 400" fill="none">
        <circle class="vfig__orbit" cx="200" cy="200" r="130" />
        <circle class="vfig__orbit vfig__orbit--2" cx="200" cy="200" r="90" />
        <circle class="vfig__orbit" cx="200" cy="200" r="50" />
        <line class="vfig__hand" x1="200" y1="200" x2="200" y2="80" />
        <line class="vfig__hand vfig__hand--2" x1="200" y1="200" x2="300" y2="200" />
        <circle cx="200" cy="200" r="5" class="vfig__nodes" />
      </svg>
    )
  }
  {
    name === 'hold' && (
      <svg viewBox="0 0 400 400" fill="none">
        <rect class="vfig__frame" x="70" y="70" width="260" height="260" />
        <rect class="vfig__frame vfig__frame--in" x="100" y="100" width="200" height="200" />
        <line class="vfig__halt" x1="200" y1="40" x2="200" y2="360" />
        <text class="vfig__label" x="200" y="384" text-anchor="middle">HOLD</text>
      </svg>
    )
  }
  {
    name === 'horizon' && (
      <svg viewBox="0 0 400 400" fill="none">
        <line class="vfig__axis" x1="30" y1="260" x2="370" y2="260" />
        <g class="vfig__rise">
          <line x1="60" y1="260" x2="60" y2="230" />
          <line x1="100" y1="260" x2="100" y2="200" />
          <line x1="140" y1="260" x2="140" y2="170" />
          <line x1="180" y1="260" x2="180" y2="150" />
          <line x1="220" y1="260" x2="220" y2="120" />
          <line x1="260" y1="260" x2="260" y2="100" />
          <line x1="300" y1="260" x2="300" y2="80" />
          <line x1="340" y1="260" x2="340" y2="70" />
        </g>
        <text class="vfig__label" x="200" y="310" text-anchor="middle">HORIZON · NOT A SHIPMENT</text>
      </svg>
    )
  }
  {
    name === 'jump' && (
      <svg viewBox="0 0 400 400" fill="none">
        <text class="vfig__core vfig__core--xl" x="200" y="150" text-anchor="middle">JMP</text>
        <path class="vfig__path" d="M70 250 L 200 250 L 280 180" />
        <polygon class="vfig__arrow" points="280,180 250,186 262,208" />
        <text class="vfig__label" x="200" y="320" text-anchor="middle">NEAR JUMP 0xE9</text>
      </svg>
    )
  }
</div>
