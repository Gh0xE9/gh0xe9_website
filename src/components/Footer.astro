---
import { links, site } from '../lib/site';
import { localizeHref, type Locale } from '../lib/i18n';
import { t } from '../lib/messages';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<footer class="site-footer">
  <div class="site-footer__row">
    <div>
      <Wordmark class="wm--footer" />
      <p class="colophon">
        {site.tagline}<br />
        {site.mottoEn}<br />
        {copy.motto} {copy.footerQuiet}
      </p>
    </div>
    <nav class="footer-links" aria-label={copy.footerLinksAria}>
      <a href={links.official} rel="noopener">{copy.officialLink}</a>
      <a href={links.github} rel="noopener">GitHub</a>
      <a href={links.x} rel="noopener">X</a>
      <a href={`mailto:${links.email}`}>{links.email}</a>
      <a href={localizeHref(locale, '/rss.xml')}>RSS</a>
    </nav>
  </div>
  <p class="colophon">
    {copy.wechatFooter} {links.wechat.name} · ID {links.wechat.id}
    <br />
    {copy.contact.locationTitle} · {copy.contact.location}
    <br />
    JMP 0xE9
  </p>
</footer>
