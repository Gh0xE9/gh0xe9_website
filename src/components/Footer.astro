---
import { links, site } from '../lib/site';
---

<footer class="site-footer">
  <div class="site-footer__row">
    <p class="colophon">
      <b>{site.name}</b> · {site.tagline}<br />
      {site.mottoEn}<br />
      {site.mottoZh} 低调说话，高调做事。
    </p>
    <nav class="footer-links" aria-label="站外链接">
      <a href={links.official} rel="noopener">官网</a>
      <a href={links.github} rel="noopener">GitHub</a>
      <a href={links.x} rel="noopener">X</a>
      <a href={links.ctftime} rel="noopener">CTFtime</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <p class="colophon">
    微信公众号 {links.wechat.name} · ID {links.wechat.id} · JMP 0xE9
  </p>
</footer>
